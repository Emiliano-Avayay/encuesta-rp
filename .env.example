# Required in production. Generate a long random value, for example:
# openssl rand -base64 48
AUTH_SECRET=change_me_to_a_long_random_value
ADMIN_USERNAME=admin
# Generate with: node scripts/hash-password.mjs "a-strong-password"
# Keep the single quotes when pasting a generated hash; its $ characters must
# not be interpolated by Docker Compose.
ADMIN_PASSWORD_HASH='pbkdf2$120000$replace_salt$replace_hash'

# Docker PostgreSQL (use values appropriate for this installation).
POSTGRES_DB=encuestas_rp
POSTGRES_USER=encuestas_rp_user
POSTGRES_PASSWORD=change_me_to_a_strong_url_safe_password

# HTTP listener on the host. It is intentionally bound to 127.0.0.1.
WEB_PORT=3000

# Optional only for development or an externally managed PostgreSQL instance.
DATABASE_URL=
PG_SSL=false
